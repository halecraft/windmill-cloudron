+// --- OAuth login flow routes ---
+
+/// GET /api/oauth/login/{client_name}
+/// Initiates the OAuth login redirect to the provider's authorization URL.
+#[cfg(all(feature = "oauth2", not(feature = "private")))]
+async fn oauth_login(
+    Path(client_name): Path<String>,
+    cookies: Cookies,
+) -> error::Result<axum::response::Redirect> {
+    let clients = OAUTH_CLIENTS.load();
+    let extra_params = clients
+        .logins
+        .get(&client_name)
+        .and_then(|c| c.extra_params.clone());
+    windmill_oauth::oauth_redirect(
+        &clients.logins,
+        client_name,
+        cookies,
+        None,
+        extra_params,
+        IS_SECURE.load(Ordering::Relaxed),
+    )
+}
+
+/// POST /api/oauth/login_callback/{client_name}
+/// Handles the OAuth callback: exchanges code for token, fetches user info,
+/// creates or finds the user, and issues a session token.
+#[cfg(all(feature = "oauth2", not(feature = "private")))]
+async fn oauth_login_callback(
+    Path(client_name): Path<String>,
+    Extension(db): Extension<DB>,
+    cookies: Cookies,
+    Json(callback): Json<windmill_oauth::OAuthCallback>,
+) -> error::Result<String> {
+    let clients = OAUTH_CLIENTS.load();
+    let client_w_scopes = clients
+        .logins
+        .get(&client_name)
+        .ok_or_else(|| error::Error::BadRequest(format!("Unknown OAuth client: {client_name}")))?;
+
+    let client = client_w_scopes.client.clone();
+    let extra_params = client_w_scopes.extra_params_callback.clone();
+
+    // Exchange authorization code for access token
+    let token = windmill_oauth::exchange_code::<TokenResponse>(
+        callback,
+        &cookies,
+        client,
+        extra_params,
+        &OAUTH_HTTP_CLIENT,
+    )
+    .await?;
+
+    let access_token_str = token.access_token.to_string();
+
+    // Fetch user email from the provider
+    let email = get_user_email(
+        &client_name,
+        client_w_scopes,
+        &access_token_str,
+    )
+    .await?;
+
+    let email = email.to_lowercase();
+    if email.is_empty() {
+        return Err(error::Error::BadRequest(
+            "Could not determine email from OAuth provider. Ensure your account has a verified email."
+                .to_string(),
+        ));
+    }
+
+    tracing::info!(%email, provider = %client_name, "OAuth login");
+
+    let mut tx = db.begin().await.map_err(|e| {
+        error::Error::InternalErr(format!("Failed to begin transaction: {e}"))
+    })?;
+
+    // Check if user already exists
+    let existing: Option<(String, bool)> = sqlx::query_as(
+        "SELECT email, super_admin FROM password WHERE email = $1",
+    )
+    .bind(&email)
+    .fetch_optional(&mut *tx)
+    .await
+    .map_err(|e| error::Error::InternalErr(format!("DB query failed: {e}")))?;
+
+    let (super_admin, is_new_user) = if let Some((_email, sa)) = existing {
+        (sa, false)
+    } else {
+        // Auto-create user on first OAuth login
+        // First user becomes super_admin, subsequent users do not
+        let is_first_user = sqlx::query_scalar::<_, i64>("SELECT COUNT(*) FROM password")
+            .fetch_one(&mut *tx)
+            .await
+            .unwrap_or(0)
+            == 0;
+
+        sqlx::query(
+            "INSERT INTO password (email, password_hash, login_type, verified, super_admin, username) \
+             VALUES ($1, '', $2, true, $3, $4) \
+             ON CONFLICT (email) DO NOTHING",
+        )
+        .bind(&email)
+        .bind(&client_name)
+        .bind(is_first_user)
+        .bind(&email)
+        .execute(&mut *tx)
+        .await
+        .map_err(|e| error::Error::InternalErr(format!("Failed to create user: {e}")))?;
+
+        (is_first_user, true)
+    };
+
+    // Auto-add new users to workspaces with auto_invite enabled
+    // In EE, this is handled by workspaces_ee::auto_add_user (private repo).
+    // We implement the core logic here: query workspace_settings for enabled
+    // auto-invite, then INSERT into usr + usr_to_group for each.
+    if is_new_user {
+        let username_prefix = email.split('@').next().unwrap_or("user");
+        // Strip non-alphanumeric/underscore chars for a valid windmill username
+        let clean_username: String = username_prefix
+            .chars()
+            .filter(|c| c.is_alphanumeric() || *c == '_')
+            .collect();
+        let clean_username = if clean_username.is_empty() {
+            "user".to_string()
+        } else {
+            clean_username
+        };
+
+        let auto_invite_workspaces: Vec<(String, Option<bool>)> = sqlx::query_as(
+            "SELECT workspace_id, (auto_invite->>'operator')::boolean as operator \
+             FROM workspace_settings \
+             WHERE auto_invite->>'enabled' = 'true'",
+        )
+        .fetch_all(&mut *tx)
+        .await
+        .unwrap_or_default();
+
+        for (ws_id, operator) in &auto_invite_workspaces {
+            let op = operator.unwrap_or(false);
+
+            // Add user to workspace (ON CONFLICT DO NOTHING for idempotency)
+            sqlx::query(
+                "INSERT INTO usr (workspace_id, email, username, is_admin, operator) \
+                 VALUES ($1, $2, $3, false, $4) \
+                 ON CONFLICT DO NOTHING",
+            )
+            .bind(ws_id)
+            .bind(&email)
+            .bind(&clean_username)
+            .bind(op)
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| error::Error::InternalErr(format!(
+                "Failed to auto-add user to workspace {}: {e}", ws_id
+            )))?;
+
+            // Add user to the 'all' group in the workspace
+            sqlx::query(
+                "INSERT INTO usr_to_group (workspace_id, usr, group_) \
+                 VALUES ($1, $2, 'all') \
+                 ON CONFLICT DO NOTHING",
+            )
+            .bind(ws_id)
+            .bind(&clean_username)
+            .execute(&mut *tx)
+            .await
+            .map_err(|e| error::Error::InternalErr(format!(
+                "Failed to add user to 'all' group in workspace {}: {e}", ws_id
+            )))?;
+
+            tracing::info!(%email, workspace = %ws_id, "Auto-added new OAuth user to workspace");
+        }
+    }
+
+    // Audit log the login
+    let audit_author = AuditAuthor {
+        email: email.clone(),
+        username: email.clone(),
+        username_override: None,
+        token_prefix: None,
+    };
+    let _ = audit_log(
+        &mut *tx,
+        &audit_author,
+        "oauth.login",
+        ActionKind::Create,
+        "global",
+        Some(&client_name),
+        None,
+    )
+    .await;
+
+    // Create session token (sets cookie too)
+    let token = windmill_api_users::users::create_session_token(
+        &email,
+        super_admin,
+        &mut tx,
+        cookies,
+    )
+    .await?;
+
+    tx.commit().await.map_err(|e| {
+        error::Error::InternalErr(format!("Failed to commit transaction: {e}"))
+    })?;
+
+    Ok(token)
+}
+
+/// Fetch the user's email from the OAuth provider using the access token.
+/// Handles provider-specific endpoints (e.g. GitHub uses /user/emails).
+#[cfg(all(feature = "oauth2", not(feature = "private")))]
+async fn get_user_email(
+    client_name: &str,
+    client_w_scopes: &ClientWithScopes,
+    access_token: &str,
+) -> error::Result<String> {
+    // GitHub uses a separate /user/emails endpoint
+    if client_name == "github" {
+        let emails: Vec<windmill_oauth::GHEmailInfo> =
+            windmill_oauth::http_get_user_info(
+                &OAUTH_HTTP_CLIENT,
+                "https://api.github.com/user/emails",
+                access_token,
+            )
+            .await?;
+        let primary = emails
+            .iter()
+            .find(|e| e.primary && e.verified)
+            .or_else(|| emails.iter().find(|e| e.verified))
+            .ok_or_else(|| {
+                error::Error::BadRequest(
+                    "No verified email found on GitHub account".to_string(),
+                )
+            })?;
+        return Ok(primary.email.clone());
+    }
+
+    // Generic OIDC / OAuth2 providers: use the userinfo_url
+    if let Some(ref userinfo_url) = client_w_scopes.userinfo_url {
+        #[derive(Deserialize)]
+        struct UserInfo {
+            email: Option<String>,
+        }
+        let info: UserInfo = windmill_oauth::http_get_user_info(
+            &OAUTH_HTTP_CLIENT,
+            userinfo_url,
+            access_token,
+        )
+        .await?;
+        if let Some(email) = info.email {
+            return Ok(email);
+        }
+    }
+
+    Err(error::Error::BadRequest(format!(
+        "Could not fetch user email from provider '{client_name}'. \
+         Ensure the provider is configured with a userinfo_url and the 'email' scope."
+    )))
+}
+
