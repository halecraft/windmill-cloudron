+pub fn send_email_if_possible(subject: &str, content: &str, to: &str) {
+    #[cfg(feature = "smtp")]
+    {
+        let subject = subject.to_string();
+        let content = content.to_string();
+        let to = to.to_string();
+        tokio::spawn(async move {
+            let smtp_opt = crate::worker::SMTP_CONFIG.load();
+            let smtp = match smtp_opt.as_ref() {
+                Some(smtp) => smtp.clone(),
+                None => {
+                    tracing::debug!(
+                        "SMTP not configured, skipping email to {to} with subject: {subject}"
+                    );
+                    return;
+                }
+            };
+            if let Err(e) =
+                send_email_inner(&subject, &content, true, vec![to.clone()], smtp, None).await
+            {
+                tracing::error!(
+                    to = %to,
+                    subject = %subject,
+                    error = %e,
+                    "Failed to send email"
+                );
+            }
+        });
+    }
+    #[cfg(not(feature = "smtp"))]
+    {
+        let _ = (subject, content, to);
+        tracing::warn!("send_email_if_possible: smtp feature not enabled");
+    }
+}
