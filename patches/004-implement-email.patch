@@ -5,42 +5,168 @@ pub use crate::email_ee::*;
 #[cfg(not(feature = "private"))]
 use crate::server::Smtp;
 
+#[cfg(all(feature = "smtp", not(feature = "private")))]
+async fn send_email_inner(
+    subject: &str,
+    content: &str,
+    content_is_html: bool,
+    to: Vec<String>,
+    smtp: Smtp,
+    client_timeout: Option<tokio::time::Duration>,
+) -> crate::error::Result<()> {
+    use mail_send::SmtpClientBuilder;
+
+    if to.is_empty() {
+        return Ok(());
+    }
+
+    let host = smtp.host.as_str();
+    let mut builder = SmtpClientBuilder::new(host, smtp.port);
+
+    if smtp.tls_implicit.unwrap_or(false) {
+        builder = builder.implicit_tls(true);
+    }
+
+    if smtp.disable_tls.unwrap_or(false) {
+        builder = builder.implicit_tls(false);
+        builder = builder.allow_invalid_certs();
+    }
+
+    if let Some(timeout) = client_timeout {
+        builder = builder.timeout(timeout);
+    }
+
+    if let (Some(ref username), Some(ref password)) = (&smtp.username, &smtp.password) {
+        if !username.is_empty() {
+            builder = builder.credentials((username.as_str(), password.as_str()));
+        }
+    }
+
+    let mut message = mail_send::mail_builder::MessageBuilder::new();
+    message = message.from(smtp.from.as_str());
+
+    for recipient in &to {
+        message = message.to(recipient.as_str());
+    }
+
+    message = message.subject(subject);
+
+    if content_is_html {
+        message = message.html_body(content);
+    } else {
+        message = message.text_body(content);
+    }
+
+    let mut client = builder.connect().await.map_err(|e| {
+        crate::error::Error::InternalErr(format!("Failed to connect to SMTP server: {e}"))
+    })?;
+
+    client.send(message).await.map_err(|e: mail_send::Error| {
+        crate::error::Error::InternalErr(format!("Failed to send email: {e}"))
+    })?;
+
+    tracing::info!(
+        to = ?to,
+        subject = %subject,
+        "Email sent successfully"
+    );
+
+    Ok(())
+}
