 #[cfg(not(feature = "private"))]
 pub async fn list_audit(
-    _tx: Transaction<'_, Postgres>,
-    _w_id: String,
-    _pagination: Pagination,
-    _lq: ListAuditLogQuery,
+    mut tx: Transaction<'_, Postgres>,
+    w_id: String,
+    pagination: Pagination,
+    lq: ListAuditLogQuery,
 ) -> Result<Vec<AuditLog>> {
-    // Implementation is not open source as Audit logs is a Windmill Enterprise Edition feature
-    return Ok(vec![]);
+    let (per_page, offset) = paginate(pagination);
+
+    // Build a query over a UNION ALL of both audit tables
+    let mut sqlb = SqlBuilder::select_from(
+        "(SELECT workspace_id, id, timestamp, username, operation, action_kind, resource, parameters, span \
+         FROM audit_partitioned \
+         UNION ALL \
+         SELECT workspace_id, id, timestamp, username, operation, action_kind, resource, parameters, span \
+         FROM audit) AS combined"
+    );
+    sqlb.fields(&[
+        "workspace_id",
+        "id",
+        "timestamp",
+        "username",
+        "operation",
+        "action_kind",
+        "resource",
+        "parameters",
+        "span",
+    ]);
+
+    if lq.all_workspaces != Some(true) {
+        sqlb.and_where("workspace_id = ?".bind(&w_id));
+    }
+
+    if let Some(ref username) = lq.username {
+        sqlb.and_where("username = ?".bind(username));
+    }
+
+    if let Some(ref operation) = lq.operation {
+        sqlb.and_where("operation = ?".bind(operation));
+    }
+
+    if let Some(ref operations) = lq.operations {
+        let ops: Vec<&str> = operations.split(',').map(|s| s.trim()).collect();
+        if !ops.is_empty() {
+            let placeholders: Vec<String> = ops.iter().map(|o| format!("'{}'", o.replace('\'', "''"))).collect();
+            sqlb.and_where(format!("operation IN ({})", placeholders.join(", ")));
+        }
+    }
+
+    if let Some(ref exclude_operations) = lq.exclude_operations {
+        let ops: Vec<&str> = exclude_operations.split(',').map(|s| s.trim()).collect();
+        if !ops.is_empty() {
+            let placeholders: Vec<String> = ops.iter().map(|o| format!("'{}'", o.replace('\'', "''"))).collect();
+            sqlb.and_where(format!("operation NOT IN ({})", placeholders.join(", ")));
+        }
+    }
+
+    if let Some(ref action_kind) = lq.action_kind {
+        sqlb.and_where(format!("action_kind = '{}'::ACTION_KIND", action_kind.replace('\'', "''")));
+    }
+
+    if let Some(ref resource) = lq.resource {
+        sqlb.and_where("resource = ?".bind(resource));
+    }
+
+    if let Some(ref before) = lq.before {
+        sqlb.and_where(format!("timestamp < '{}'", before.to_rfc3339()));
+    }
+
+    if let Some(ref after) = lq.after {
+        sqlb.and_where(format!("timestamp > '{}'", after.to_rfc3339()));
+    }
+
+    sqlb.order_by("timestamp", true); // true = DESC
+    sqlb.limit(per_page);
+    sqlb.offset(offset);
+
+    let sql = sqlb
+        .sql()
+        .map_err(|e| Error::InternalErr(format!("Failed to build audit query: {e}")))?;
+
+    let rows: Vec<AuditLog> = sqlx::query_as::<_, AuditLog>(&sql)
+        .fetch_all(&mut *tx)
+        .await
+        .map_err(|e| Error::InternalErr(format!("Failed to list audit logs: {e}")))?;
+
+    tx.commit().await?;
+
+    Ok(rows)
 }
 
