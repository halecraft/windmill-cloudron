+        "enabled": enabled,
+        "operator": operator,
+        "mode": mode,
+    });
+
+    let mut tx = db.begin().await?;
+
+    sqlx::query(
+        "UPDATE workspace_settings SET auto_invite = $1 WHERE workspace_id = $2",
+    )
+    .bind(&auto_invite)
+    .bind(&w_id)
+    .execute(&mut *tx)
+    .await?;
+
+    audit_log(
+        &mut *tx,
+        &authed,
+        "workspaces.edit_auto_invite",
+        ActionKind::Update,
+        &w_id,
+        None,
+        None,
+    )
+    .await?;
+
+    tx.commit().await?;
+
+    Ok("Updated auto-invite settings".to_string())
 }
 
