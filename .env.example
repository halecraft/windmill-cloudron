# windmill-cloudron deploy configuration
# Copy this file to .env and edit as needed: cp .env.example .env

# Cloudron app location (required)
CLOUDRON_APP=windmill.halecraft.org

# Docker registry repository (auto-detected from cloudron build info if unset)
# DOCKER_REPO=docker.halecraft.org/windmill

# Cloudron Docker registry app location (for garbage collection)
# Set this to enable remote blob cleanup after old tags are deleted
# REGISTRY_APP=docker.halecraft.org
